" | parametric bootstrap P =", signif(p_boot, 3), "\n")
a
xx <- a[which(a$Histology=="YST" &a$CNV=="Loss"),]
xx
xx <- a[which(a$Histology=="YST" &a$CNV=="loss"),]
xx
yy <- a[which(a$Histology=="YST" &a$CNV!="loss"),]
yy
wilcox.test(xx$L1,yy$L1)
wilcox.test(xx$L1,yy$L1,exact = T)
wilcox.test(xx$L1,yy$L1,exact = T,alternative = "two.sided")
wilcox.test(xx$L1,yy$L1,exact = T,alternative = "two.sided",conf.int = 0.95)
wilcox.test(xx$L1,yy$L1,exact = T,alternative = "two.sided",conf.int = 0.9)
