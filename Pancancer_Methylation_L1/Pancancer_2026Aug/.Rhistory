#raw data preprocessing
Sample_features <- read.delim("./data/Genetic_profiles_All.txt",sep = "\t",header = T)
samples <- data.frame(Sample_features)
rownames(samples) <- Sample_features$case
samples$AID <- samples$case
samples$chr1p36 <- samples$PRDM2_loss
#samples$Histology <- samples$Dominant.His
#samples <-  samples[which(samples$Dominant.His != "YST" | samples$Histology != "Mix"),]
#samples$Histology <- samples$Dominant.His
samples <-  samples[which(!(  samples$case=="SJ14_2" | samples$case=="SJ18_2" | samples$case=="F004_2" | samples$case=="F007_2" | samples$case=="F005_2" |
samples$case=="SJ11"  | samples$case=="SJ21"   | samples$case=="SJ30" |
samples$case=="SJ13"   | samples$case=="T129" | samples$case=="T135" |
samples$case=="PDX45" | samples$Cohort=="Japan" |
samples$case=="JP37" )),] # | samples$Cohort=="Japan"
TE <- read.table("./data/All_TE_list.txt",header = F)
colnames(TE) <- c("name","family","type")
L1 <- TE[which(TE$family=="L1"),]
################
counts1 <- read.csv("./data/All_2025.txt", sep="", head=T, row.names = "A11_geneID",quote = "\"")
nrow(counts1)
counts1 <- counts1[, which( colnames(counts1 ) %in% samples$AID) ]
samples <- samples[which(samples$AID %in% colnames(counts1)),]
keep <- rowSums(counts1 >= 20) >= 5
counts <- counts1[keep,]
nrow(counts1)
nrow(counts)
counts <- counts[which(rownames(counts) %in% TE$name),] #[which(TE$family %in% c("L1","Alu","SVA"))]),]
count_matrix <- as.matrix(counts)
strand <- samples$Strand
batch <- samples$SeqPlatform
#batch[90] <- "UNK"
library("sva")
adjusted_counts <- ComBat_seq(count_matrix, batch=batch,group = strand,full_mod=T)#,group=strand
#adjusted_counts <-count_matrix
dds=DESeqDataSetFromMatrix(countData = adjusted_counts,colData = samples,design = ~ Histology)
vsd <- vst(dds ,blind = TRUE,nsub=100)
head(assay(vsd), 3)
expMatrix <- assay(vsd)
colnames(expMatrix) <- colnames(dds)
rownames(expMatrix) <- rownames(dds)
all(rownames(samples) %in% colnames(expMatrix))
all(colnames(expMatrix ) %in% rownames(samples))
nrow(expMatrix)
#PCA
library(genefilter)
library(ggrepel)
rv <- rowVars(expMatrix)
ntop <- 800
select <- order(rv, decreasing = TRUE)[seq_len(min(ntop,  length(rv)))]
pca <- prcomp(t(expMatrix[select, ]))
percentVar <- pca$sdev^2/sum(pca$sdev^2)
intgroup <- c("AID", "Gender", "Cohort","chr1p36","Histology")
if (!all(intgroup %in% colnames(samples))) {
stop("the argument 'intgroup' should specify columns of colData(dds)")
}
intgroup.df <- as.data.frame(samples[, intgroup, drop = FALSE])
group <- if (length(intgroup) > 1){ factor(apply(intgroup.df, 1, paste, collapse = " : ")) }else{ samples[[intgroup]]}
d <- data.frame(pca$x,intgroup.df)
myPCA <- ggplot()+theme_classic()
myPCA <- myPCA + geom_point(data = d, aes(x =PC1, y = PC2,  shape = Cohort,color=Histology),alpha=0.9,size = 2,stroke=0.5) +
xlab(paste0("PC1: ", round(percentVar[1] * 100), "% variance")) +
ylab(paste0("PC2: ", round(percentVar[2] * 100), "% variance")) #+ coord_fixed()
myPCA <- myPCA + theme(panel.background=element_rect(fill='transparent',color='transparent'),plot.margin=unit(c(2,1,0.5,1),'lines'),plot.title=element_text(size=24,vjust=0.5,hjust=0.5,face='bold.italic'),
text=element_text(size=12,face='plain',color='black'),legend.key.width=unit(1,'cm'),legend.key.height=unit(0.5,'cm'),legend.position='right',
legend.margin=margin(t=0.1,r=0.1,b=0,l=0.1,unit='cm'),legend.text=element_text(size=12,face='plain',color='black'),axis.text.y=element_text(size=12,face='plain',color='black'),
axis.text.x=element_text(size=12,face='plain',color='black'),axis.title.x=element_text(size=14,face='plain',color='black'),axis.title.y=element_text(size=14,face='plain',color='black'))
myPCA <- myPCA + geom_text_repel(data = d, aes(x =PC1, y = PC2,  label=AID),size=1)
figure_1<-rbind(ggplotGrob(myPCA ),size="first")
ggsave(file="./figs_noJP/PCA_justTE.pdf", plot=figure_1,bg = 'white', width = 14, height = 10, units = 'cm', dpi = 600)
