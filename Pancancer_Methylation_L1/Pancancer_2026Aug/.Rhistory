df$Histology <- "nonYST"
df$Histology[which(df$His == "YST")] <- "YST"
df$CNV <- "no_loss"
df$CNV[which(df$chr1p36 == "Loss")] <- "loss"
df$Histology <- factor(df$Histology, levels = c("nonYST", "YST"))
df$CNV <- factor(df$CNV, levels = c("no_loss", "loss"))
table(df$Histology )
table(df$CNV)
