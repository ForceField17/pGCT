markers_for_heatmap <- function(markers) {
res <- NULL
for (i in unique(markers[, 1])) {
tmp <- markers[markers[, 1] == i, ]
res <- rbind(res, tmp)
}
return(res)
}
marker <- markers_for_heatmap(markers)
scale_rows = function(x){
m = apply(x, 1, mean, na.rm = T)
s = apply(x, 1, sd, na.rm = T)
return((x - m) / s)
}
