gg_color_hue <- function(n) {
hues = seq(15, 375, length = n + 1)
hcl(h = hues, l = 65, c = 150)[1:n]
}
markers <- read.table(file="Figs/results_markers_k3.txt",sep = "\t",header=T)
markers_germinoma <- markers$feature_symbol[which(markers$sc3_3_markers_clusts==1)]
markers_teratomas <- markers$feature_symbol[which(markers$sc3_3_markers_clusts==2)]
markers_YST <- markers$feature_symbol[which(markers$sc3_3_markers_clusts==3)]
geneUniverse <- read.table(file="lib/background_genes.txt",sep = "\t",header=T)
Universe <- geneUniverse$gene
library(org.Hs.eg.db)
Genes_germinoma <- unlist(mget(markers_germinoma, envir=org.Hs.egSYMBOL2EG,ifnotfound = NA))
Genes_teratomas <- unlist(mget(markers_teratomas, envir=org.Hs.egSYMBOL2EG,ifnotfound = NA))
Genes_YST <- unlist(mget(markers_YST, envir=org.Hs.egSYMBOL2EG,ifnotfound = NA))
Genes_Universe <- unlist(mget(Universe, envir=org.Hs.egSYMBOL2EG,ifnotfound = NA))
############################# cluster 1
ans.go <- enrichGO(gene = Genes_germinoma, ont = "BP",OrgDb ="org.Hs.eg.db",
universe = Genes_Universe, readable=TRUE,pvalueCutoff = 0.05)
tab.go <- as.data.frame(ans.go)
write.table(tab.go,file = "./Figs/Table_GO_enrichment_for_cluster1_markers.txt",quote = F,sep = "\t",row.names = F)
#tab.go<- subset(tab.go, Count>5)
tab.go[1:5, 1:6]
library(enrichplot)
p1 <- barplot(ans.go, showCategory=20)
p1
library("ggupset")
p2 <- upsetplot(ans.go)
p2
new <- pairwise_termsim(ans.go)
p3 <- emapplot(new,showCategory = 10,layout = "star",shadowtext = F)
new
p1
p2
p1
p3 <- emapplot(new,showCategory = 10,layout = "star",shadowtext = F)
p3 <- emapplot(new,showCategory = 10,layout = "star",shadowtext = T)
p3 <- emapplot(new,showCategory = 10,layout = "star")
pdf(file = paste0("./Figs/GOEN_cluster1_germinoma.pdf"),width=7,height=7)
p3
dev.off()
############################# cluster 2
ans.go <- enrichGO(gene = Genes_teratomas, ont = "BP",OrgDb ="org.Hs.eg.db",
universe = Genes_Universe, readable=TRUE,pvalueCutoff = 0.05)
tab.go <- as.data.frame(ans.go)
write.table(tab.go,file = "./Figs/Table_GO_enrichment_for_cluster2_markers.txt",quote = F,sep = "\t",row.names = F)
