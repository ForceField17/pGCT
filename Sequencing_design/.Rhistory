highlight <- c("NANOG","SALL4","AFP","POU5F1","PRDM14","LIN28A","ERBB4","APOA1","APOA2","TFAP2C","GATA6","GATA4","GATA3","GATA5","FOXA2","NANOS3","MAGEB1","KRT5","KRT4","KRT13","KRT1","KRT17","KRT15","KRT6A","KRT1","BMP2",
"MAPT","RELN","ROBO2","KIF1A","CXCL9","PDPN","FCRL5","CXCL10")
