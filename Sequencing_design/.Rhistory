PRDM2_loss = c(del='#92c5de',Loss='#92c5de', WT='grey95',Not.Available='grey60'),
focal11q_loss = c(Mut='#92c5de', WT='grey95',Not.Available='grey60'),
chrXq =   c(del='#0571b0',loss='#92c5de',normal='grey95',gain='#f4a582',amp='#ca0020',Not.Available='grey60'),
chr21q = c(del='#0571b0',loss='#92c5de',normal='grey95',gain='#f4a582',amp='#f4a582',Not.Available='grey60'),
chr12p = c(del='#0571b0',loss='#92c5de',normal='grey95',gain='#f4a582',amp='#f4a582',Not.Available='grey60'),
chr8q =  c(del='#0571b0',loss='#92c5de',normal='grey95',gain='#f4a582',amp='#ca0020',Not.Available='grey60'),
karyo = c(WT='grey95',Trisomy21=gg_color_hue(4)[1],XO=gg_color_hue(4)[4],Not.Available='grey60',f_NA="grey60"),
wgd = c(WT='grey95',WGD='#d01c8b',Not.Available='grey60'),
chromtri = c(WT='grey95',Chromtripsis='black',Not.Available='grey60'),
Markers = c(Germinoma=gg_color_hue(5)[1],IMT=gg_color_hue(5)[2],Mix=gg_color_hue(5)[3],Teratoma=gg_color_hue(5)[4],YST=gg_color_hue(5)[5],G_and_Y="red",I_and_T="blue", others="grey95"),
Cluster = c(C1="#cab2d6",C2="#b3de69",C3="#fdb462"),
LINE = colorRampPalette(c("#0000CC","#3333FF","#9999FF", "grey95","#FF9999","#FF3333","#CC0000"))(50),
PRDM2_zscore = colorRampPalette(c("#000099","#0000CC","#0000FF","#3333FF","#6666FF","#9999FF","#CCCCFF", "grey95","#FFCCCC","#FF9999","#FF6666","#FF3333", "#FF0000","#CC0000","#990000"))(50)
)
object <- sce; k=3
dat <- colData(object)[, c( "case", paste0("sc3_", k, "_clusters"), paste0("sc3_", k, "_log2_outlier_score"))]
clutering <- as.data.frame(dat)
write.table(clutering ,file="Figs/results_clutering_k3.txt",sep = "\t",quote = F,row.names = F)
anno_col <- data.frame(samples[, c("Histology")])
colnames(anno_col) <- c("Histology")
rownames(anno_col) <- rownames(samples)
hc <- metadata(object)$sc3$consensus[[as.character(k)]]$hc
consensus <- metadata(object)$sc3$consensus[[as.character(k)]]$consensus
pdf(file = paste0("./Figs/consensus_plot_k3.pdf"),width=16,height=14)
ComplexHeatmap::pheatmap(consensus,cluster_cols = hc,cluster_rows = hc,cutree_rows = k, cutree_cols = k,treeheight_col = 30,treeheight_row = 30,
show_rownames = F, show_colnames = F,border_color = "grey30", cellwidth = 7, cellheight = 7,
color = colorRampPalette(c("#2166ac","#67a9cf","#d1e5f0", "grey95","#fddbc7","#ef8a62","#b2182b"))(50),
annotation_col = anno_col,annotation_row = anno_col,annotation_colors = ann_colors)
dev.off()
##########################################
# get all marker genes
k = 3; p.val = 0.01; auroc = 0.85
dat <- rowData(object)[, c(paste0("sc3_", k, "_markers_clusts"), paste0("sc3_", k, "_markers_auroc"), paste0("sc3_", k, "_markers_padj"), "feature_symbol")]
dat <- dat[dat[, paste0("sc3_", k, "_markers_padj")] < p.val & !is.na(dat[, paste0("sc3_", k, "_markers_padj")]), ]
dat <- dat[dat[, paste0("sc3_", k, "_markers_auroc")] > auroc, ]
d <- NULL
for (i in sort(unique(dat[, paste0("sc3_", k, "_markers_clusts")]))) {
tmp <- dat[dat[, paste0("sc3_", k, "_markers_clusts")] == i, ]
tmp <- tmp[order(tmp[, paste0("sc3_", k, "_markers_auroc")], decreasing = TRUE), ]
d <- rbind(d, tmp)
}
markers <- as.data.frame(d)
write.table(markers,file="Figs/results_markers_k3.txt",sep = "\t",quote = F,row.names = F)
row.ann <- data.frame(Cluster = factor(markers[, 1], levels = unique(markers[, 1])))
rownames(row.ann) <- markers$feature_symbol
row.ann$Cluster <- paste0("C",row.ann$Cluster)
