###################
SubtypingMatrix <- expMatrix_new
topGenes <- head(order(rowSds(SubtypingMatrix), decreasing = TRUE), 1000)
mat1 <- SubtypingMatrix[topGenes,]
anno <- as.data.frame(colData(vsd)[, c("case","chromtri","PRDM2_loss","chr12p","wgd","PI3K_pathway","MAPK_pathway","KIT","Site","Cohort","Gender","Dominant.His","Histology")])
# create a SingleCellExperiment object
sce <- SingleCellExperiment::SingleCellExperiment(
assays = list(logcounts = as.matrix(mat1)),
colData = anno
)
rowData(sce)$feature_symbol <- rownames(sce)
sce <- sce[!duplicated(rowData(sce)$feature_symbol), ]
#clustering
sce <- sc3(sce, ks = 2:16, biology = TRUE,gene_filter = FALSE)
#sc3_interactive(sce)
sc3_export_results_xls(sce,filename = "./Figs/sc3_results.xls")
object <- sce
Silhouette <- data.frame(c(2:16),rep(0,15))
colnames(Silhouette) <- c("k","width")
for(i in c(1:15)){
Silhouette$width[i] <- mean(as.data.frame(metadata(object)$sc3$consensus[[as.character(Silhouette$k[i])]]$silhouette)$sil_width)
}
NAN_plot <- ggplot(data=Silhouette ,aes(x=k,y=width)) + theme_classic()
NAN_plot <- NAN_plot +
geom_point(data=Silhouette ,aes(x=k,y=width),size=2,color="black",alpha=1)+
geom_line(data=Silhouette ,aes(x=k,y=width),size=1,color="black",alpha=1)
NAN_plot <-NAN_plot + theme(panel.background=element_rect(fill='transparent',color='transparent'),plot.margin=unit(c(2,2,2,3),'lines'),
plot.title=element_text(size=34,vjust=0.5,hjust=0.5,face='bold.italic',color='transparent'),text=element_text(size=14,face='bold'),
legend.key.width=unit(0.6,'cm'),legend.key.height=unit(0.6,'cm'),legend.position='none',legend.text=element_text(size=14,hjust=0,face='bold'),
axis.text.x=element_text(size=14,face='plain',color='black'),axis.text.y=element_text(size=14,face='plain',color='black'),
axis.title.x=element_text(size=14,face='plain',color='black'),axis.title.y=element_text(size=14,face='plain',color='black'))
NAN_plot <- NAN_plot + scale_y_continuous(expand=c(0,0),limits=c(0.5,1),breaks = seq(0,1,0.1))
NAN_plot <- NAN_plot + scale_x_continuous(expand=c(0,0),limits=c(1.5,16.5),breaks = seq(2,16,1))
NAN_plot<- NAN_plot +ylab("Average silhouette width") +xlab("Number of clusters k")
figure_2<-rbind(ggplotGrob(NAN_plot),size="last")
ggsave(file="./Figs/silhouette_plot.pdf", plot=figure_2,bg = 'white', width =16, height = 9, units = 'cm', dpi = 600)
#heatmap
gg_color_hue <- function(n) {
hues = seq(15, 375, length = n + 1)
hcl(h = hues, l =80, c = 90)[1:n]
}
ann_colors = list(
Histology = c(Germinoma=gg_color_hue(5)[1],IMT=gg_color_hue(5)[2],Mix="#00E6AA",Teratoma="#1aa3d9",YST=gg_color_hue(5)[5],EC="red",Lymph="black"),
Dominant.His = c(Germinoma=gg_color_hue(5)[1],IMT=gg_color_hue(5)[2],Mix="#00E6AA",Teratoma="#1aa3d9",YST=gg_color_hue(5)[5],EC="red",Lymph="black"),
Minor.His = c(Germinoma=gg_color_hue(5)[1],IMT=gg_color_hue(5)[2],Mix=gg_color_hue(5)[3],Teratoma=gg_color_hue(5)[4],YST=gg_color_hue(5)[5],EC="red",Lymph="black"),
Cohort = c(Xinhua='#b3de69',BASIC3='#80b1d3',CBTTC='#f1b6da',Nature2014='#dfc27d',StJude='#8dd3c7'),
Gender = c(Male='#b3cde3',Female='#fccde5'),
Site = c(Intracranial="#9970ab",Extracranial="#a6dba0"),
KIT_point = c(amp='#35978f',Mut='#35978f',  WT='grey95',Not.Available='grey60'),
