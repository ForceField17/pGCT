for( i in 2:length(FrequentGene)){
gene.Matrix <- cbind(gene.Matrix,rep(0,length(samples$ID)))
}
for(i in 1:length(samples$ID)){
for(j in 1:length(FrequentGene)){
gene.Matrix[i,j] <- nrow(Mutpool[which(Mutpool$CaseID==samples$ID[i] & Mutpool$Gene_Name==FrequentGene[j]),])
}
}
colnames(gene.Matrix) <- FrequentGene
rownames(gene.Matrix) <- samples$ID
M<-t(gene.Matrix)
mat <- memoSort(M,sortGenes = FALSE)
Mat <- as.data.frame(mat)
ann_colors = list(
Histology = c(Germinoma=gg_color_hue(5)[1],IMT=gg_color_hue(5)[2],Mix="#00E6AA",Teratoma="#1aa3d9",YST=gg_color_hue(5)[5],EmbryonalC="#bebada",ChorioC="grey70",GCT="grey70",NGGCT="grey70"),
Domin.His = c(Germinoma=gg_color_hue(5)[1],IMT=gg_color_hue(5)[2],Mix="#00E6AA",Teratoma="#1aa3d9",YST=gg_color_hue(5)[5],EmbryonalC="#bebada",ChorioC="grey70",GCT="grey70",NGGCT="grey70"),
Cohort = c(Xinhua='#b3de69',BASIC3='#80b1d3',CBTTC='#f1b6da',Nature2014='#dfc27d',StJude='#8dd3c7'),
Gender = c(Male='#b3cde3',Female='#fccde5'),
SALL4 = c(WT="grey100",DNM="#f46d43"),
PrimarySite = c(Intracranial="#9970ab",Extracranial="#a6dba0",No="grey70"),
Karyotype = c(Normal='grey100',Trisomy21="#f46d43",XO="#f46d43",XXY='#f46d43',XY='#f46d43',f_NA="grey70"),
Race = c(Asian="#ffd92f",  Black="#386cb0",  China="#ffd92f", Indian="#b3de69" ,Japan="#ffd92f",  White= "#80cdc1", White.Asian="#b3de69" , White.Black="#b3de69", White.Indian="#b3de69",NOS="grey60"),
age = colorRampPalette(c("#f5f5f5","#c7eae5","#80cdc1","#35978f","#01665e"))(50)
)
samples$age <- as.numeric(as.character(samples$Age)) +1
samples$age[which(is.na(samples$age))] <- 0
anno_col <- data.frame(samples[, c("Karyotype","Race","Gender","Histology","PrimarySite","Domin.His")])
rownames(anno_col) <- samples$ID
pdf(file = paste0("./landscape_germline_pathogenic_variants.pdf"),width=36,height=14)
pheatmap(Mat,cluster_cols = F,cluster_rows = F,
show_rownames = T, show_colnames = T,border_color = "grey60", cellwidth = 8, cellheight = 12,
color = c( "grey100","#f46d43"),annotation_col = anno_col,annotation_colors = ann_colors,na_col="grey70")
dev.off()
#######################################################################3
AllGermlineSample <- read.table("../../../Sequencing_design/all_eroll_patients_2025_dysgeminoma.txt",header = T)
samples <- AllGermlineSample[which(AllGermlineSample$PatientBlood_WGS=="Yes" | AllGermlineSample$PatientBlood_WES=="Yes"),c("ID","Histology","Karyotype","Age","Gender","PrimarySite","Race","PatientTumor_WGS","PatientTumor_WES","FatherBlood_WGS","MotherBlood_WGS","Domin.His")]
samples <- samples[which(samples$ID %in% Mutpool$CaseID | samples$Karyotype != "Normal" ),]
samples$TumorDNA <- "No"
samples$TumorDNA[which( samples$PatientTumor_WES=="Yes")] <- "WES"
samples$TumorDNA[which(samples$PatientTumor_WGS=="Yes" )] <- "WGS"
samples$Trios <- "No"
samples$Trios[which(samples$FatherBlood_WGS=="Yes" & samples$MotherBlood_WGS=="Yes" )] <- "WGS"
gene.Matrix <- rep(0,length(samples$ID))
for( i in 2:length(FrequentGene)){
gene.Matrix <- cbind(gene.Matrix,rep(0,length(samples$ID)))
}
for(i in 1:length(samples$ID)){
for(j in 1:length(FrequentGene)){
xxx <- Mutpool[which(Mutpool$CaseID==samples$ID[i] & Mutpool$Gene_Name==FrequentGene[j]),]
if(nrow(xxx)>0){
if(xxx$MutType=="Germline"){
gene.Matrix[i,j] <- 1
}
else if(xxx$MutType=="DNM"){
gene.Matrix[i,j] <- 2
}else{
gene.Matrix[i,j] <- 3
}
}
else{
gene.Matrix[i,j] <- 0
}
}
}
colnames(gene.Matrix) <- FrequentGene
rownames(gene.Matrix) <- samples$ID
M<-t(gene.Matrix)
mat <- memoSort(M,sortGenes = FALSE)
Mat <- as.data.frame(mat)
