gg_color_hue <- function(n) {
hues = seq(15, 375, length = n + 1)
hcl(h = hues, l = 65, c = 150)[1:n]
}
scale_rows = function(x){
m = apply(x, 1, mean, na.rm = T)
s = apply(x, 1, sd, na.rm = T)
return((x - m) / s)
}
data_summary <- function(x) {
m <- mean(x)
ymin <- m-sd(x)
ymax <- m+sd(x)
return(c(y=m,ymin=ymin,ymax=ymax))
}
#get CNV cases
#raw data preprocessing
Sample_features <- read.table("results/Info_Cell.txt",sep = "\t",header = T)
samples <- data.frame(Sample_features)
rownames(samples) <- Sample_features$Sample
samples <- samples[which(samples$Patient!="T22_1"),]
#samples <- samples[which(samples$HyperMut!="Hyper" ),]
samples <- samples[which(samples$HyperMut!="Hyper" & (samples$Type!="TMZ" | samples$Batch!="QM")),]
################
counts1 <- read.table("results/merged_AllRNA_featurecounts.txt", sep="", head=T, row.names = "Geneid")
counts <- counts1[,which((colnames(counts1 ) %in% samples$Sample ))]
nrow(counts)
xxx <- counts
keep <- rowSums(xxx > 50) >= 3
counts <- counts[keep,]
nrow(counts)
count_matrix <- as.matrix(counts)
batch <- as.factor(samples$bat)
group <- as.factor(samples$Type)
library("sva")
#adjusted_counts <- ComBat_seq(count_matrix, batch=batch, group=group)
adjusted_counts <- counts
dds=DESeqDataSetFromMatrix(countData = adjusted_counts,colData = samples,design = ~ Type)
#dds=DESeqDataSetFromMatrix(countData = counts,colData = samples,design = ~ Type)
vsd <- vst(dds ,blind = TRUE)
head(assay(vsd), 3)
expMatrix_new <- assay(vsd)
expMatrix <- normalize.quantiles(expMatrix_new, copy = TRUE)
all(rownames(samples) %in% colnames(expMatrix_new ))
all(colnames(expMatrix_new ) %in% rownames(samples))
#PCA
library(genefilter)
library(ggrepel)
#expMatrix <- expMatrix_new
rv <- rowVars(expMatrix)
ntop <- 500
select <- order(rv, decreasing = TRUE)[seq_len(min(ntop,  length(rv)))]
pca <- prcomp(t(expMatrix[select, ]))
percentVar <- pca$sdev^2/sum(pca$sdev^2)
intgroup <- c("Sample",  "Type","Patient","Batch")
if (!all(intgroup %in% colnames(samples))) {
stop("the argument 'intgroup' should specify columns of colData(dds)")
}
intgroup.df <- as.data.frame(samples[, intgroup, drop = FALSE])
group <- if (length(intgroup) > 1){ factor(apply(intgroup.df, 1, paste, collapse = " : ")) }else{ samples[[intgroup]]}
d <- data.frame(pca$x,intgroup.df)
myPCA <- ggplot()+theme_classic()
myPCA <- myPCA + geom_point(data = d, aes(x =PC1, y = PC2,  fill = Batch,shape=Type),alpha=0.9,size = 3.6) +
xlab(paste0("PC1: ", round(percentVar[1] * 100), "% variance")) + scale_shape_manual(values = c(21,22))+
scale_fill_manual(values = c(QM = "#1b9e77",T2_4="#d95f02",T2_4.old="#fdc086",T21="#7570b3"),guide = guide_legend(override.aes=list(shape=21)))+
ylab(paste0("PC2: ", round(percentVar[2] * 100), "% variance")) #+ coord_fixed()
myPCA <- myPCA + theme(panel.background=element_rect(fill='transparent',color='transparent'),plot.margin=unit(c(2,1,0.5,1),'lines'),plot.title=element_text(size=24,vjust=0.5,hjust=0.5,face='bold.italic'),
text=element_text(size=12,face='plain',color='black'),legend.key.width=unit(1,'cm'),legend.key.height=unit(1,'cm'),legend.position='right',
legend.margin=margin(t=0.1,r=0.1,b=0,l=0.1,unit='cm'),legend.text=element_text(size=12,face='plain',color='black'),axis.text.y=element_text(size=12,face='plain',color='black'),
axis.text.x=element_text(size=12,face='plain',color='black'),axis.title.x=element_text(size=14,face='plain',color='black'),axis.title.y=element_text(size=14,face='plain',color='black'))
myPCA <- myPCA + geom_text(data = d, aes(x =PC1, y = PC2,  label=Sample),size=1)
#myPCA <- myPCA + scale_y_continuous(expand=c(0,0),limits=c(-20,14),breaks = seq(-20,20,10)) +
#                 scale_x_continuous(expand=c(0,0),limits=c(-20,34),breaks = seq(-20,40,10))
figure_1<-rbind(ggplotGrob(myPCA ),size="first")
ggsave(file="./figs_two_cells/PCA.pdf", plot=figure_1,bg = 'white', width = 13, height = 10, units = 'cm', dpi = 600)
########
#testing
data <- expMatrix_new
Pvalue_R1_WT <- rep(NA,nrow(data))
FoldC_R1_WT  <- rep(NA,nrow(data))
Rank_R1_WT   <- rep(NA,nrow(data))
Rank2_R1_WT  <- rep(NA,nrow(data))
nVar1 <- 0
for(i in 1:nrow(data)){
test <- data.frame(as.numeric(data[i,]),samples$Type)
colnames(test) <- c("value","Group")
rownames(test) <- colnames(data)
G0 <- test[which(test$Group=="Control"),1]
G1 <- test[which(test$Group=="TMZ"),1]
Pvalue_R1_WT[i]  <- wilcox.test(G1,G0,paired = F)$p.value
FoldC_R1_WT[i]  <-  mean(G1)-mean(G0)
Rank_R1_WT[i] <- (mean(G1)-mean(G0))
}
geneName <-rownames(expMatrix_new)
FDR_R1_WT <- p.adjust(Pvalue_R1_WT,method = "fdr")
final_data <- data.frame(geneName,Pvalue_R1_WT,FDR_R1_WT,FoldC_R1_WT)
write.csv(final_data , file = "./figs_two_cells/Statistical_T_test.csv")
####################
maker <- final_data$geneName[which( (final_data$FDR_R1_WT < 0.01 ) &
(final_data$FoldC_R1_WT > 1.5 | final_data$FoldC_R1_WT < -1.5) )]
#heatmap
ann_colors = list(
Type = c(TMZ="#e78ac3",Control="grey60"),
Batch = c(QM = "#1b9e77",T2_4="#d95f02",T2_4.old="#fdc086",T21="#7570b3")
)
mat <- expMatrix_new[which(rownames(expMatrix_new) %in%  maker),]
anno_col <- as.data.frame(samples[, c("Batch","Type")])
colnames(anno_col) <- c("Batch","Type")
pdf(file = paste0("./figs_two_cells/Markers_heatmap2.pdf"),width=12,height=8)
pheatmap(mat,cutree_rows=2,cutree_cols=2,cluster_cols =T ,cluster_rows = T,#gaps_col=c(10),
color = colorRampPalette(c('#29419E','#698DC9',"grey95",'#F67172','#DC2B18'))(50),
annotation_col = anno_col,annotation_names_col=T,show_rownames = T,annotation_legend = T,
scale = "row",annotation_colors = ann_colors,
clustering_distance_rows = "correlation",legend = TRUE, legend_breaks = NA,legend_labels = NA,
clustering_distance_cols = "correlation", #"euclidean",#cellwidth = 15, #cellheight = 2,
fontsize = 12,fontsize_row = 12, fontsize_col = 12, display_numbers = F,border_color ="transparent",
number_format = "%.0f", number_color = "grey60", fontsize_number = 2)
dev.off()
Infos <-  final_data[which(final_data$geneName %in% maker),]
write.table(Infos,file = "./figs_two_cells/Pvalues_markers.txt",sep="\t",quote = F,row.names = F)
