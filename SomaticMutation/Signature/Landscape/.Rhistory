library(rstudioapi)
# Getting the path of your current open file
current_path = rstudioapi::getActiveDocumentContext()$path
setwd(dirname(current_path ))
print( getwd() )
library("gridExtra")
library(ggplot2)
gg_color_hue <- function(n) {
hues = seq(15, 375, length = n + 1)
hcl(h = hues, l = 65, c = 150)[1:n]
}
library("scarHRD")
fls = list.files(path="./results/",pattern = "txt")
fls = fls[grepl("\\.txt",fls)]
##others
for (ix in 1:(length(fls))){
fl = fls[ix]
sid = strsplit(fl,split = "\\.")[[1]][1]
scar_score(paste0("./results/",sid,".txt"),reference = "grch38", seqz=FALSE)
}
