########
#testing
data <- expMatrix_new
Pvalue_R1_WT <- rep(NA,nrow(data))
FoldC_R1_WT  <- rep(NA,nrow(data))
Rank_R1_WT   <- rep(NA,nrow(data))
Rank2_R1_WT  <- rep(NA,nrow(data))
nVar1 <- 0
for(i in 1:nrow(data)){
test <- data.frame(as.numeric(data[i,]),samples$Type)
colnames(test) <- c("value","Group")
rownames(test) <- colnames(data)
G0 <- test[which(test$Group=="Control"),1]
G1 <- test[which(test$Group=="TMZ"),1]
Var_R1_WT <- var.test(G1,G0)$p.value
if(Var_R1_WT > 0.05){
Pvalue_R1_WT[i]  <- t.test(G1,G0,paired = F,var.equal = T)$p.value
nVar1 <- nVar1 + 1
}else{
Pvalue_R1_WT[i]   <- t.test(G1,G0,paired = F,var.equal = F)$p.value
}
FoldC_R1_WT[i]  <-  mean(G1)-mean(G0)
Rank_R1_WT[i] <- (mean(G1)-mean(G0)) / ( sd(G1)^2/length(G1) + sd(G0)^2/length(G0) )^0.5
}
geneName <-rownames(expMatrix_new)
FDR_R1_WT <- p.adjust(Pvalue_R1_WT,method = "bonferroni")
final_data <- data.frame(geneName,Pvalue_R1_WT,FDR_R1_WT,FoldC_R1_WT,Rank_R1_WT)
write.csv(final_data , file = "./figs_T21/Statistical_T_test.csv")
####################
maker <- final_data$geneName[which( (final_data$FDR_R1_WT < 0.05 ) &
(final_data$FoldC_R1_WT > 1.5 | final_data$FoldC_R1_WT < -1.5) )]
#heatmap
ann_colors = list(
Group = c(T21.TMZ1="#e78ac3",T21.TMZ2="#fc8d62",T21.TMZ3="#6666F6",T21.TMZ4="#66c2a5",T21.untreated="grey60")
)
mat <- expMatrix_new[which(rownames(expMatrix_new) %in%  maker),]
anno_col <- as.data.frame(samples[, c("Group")])
colnames(anno_col) <- c("Group")
pdf(file = paste0("./figs_T21/Markers_heatmap.pdf"),width=7,height=14.5)
pheatmap(mat,cutree_rows=2,cluster_cols =F ,cluster_rows = T,#gaps_col=c(10),
color = colorRampPalette(c('#29419E','#698DC9',"grey95",'#F67172','#DC2B18'))(50),
annotation_col = anno_col,annotation_names_col=T,show_rownames = T,annotation_legend = T,
scale = "row",annotation_colors = ann_colors,border_color = "grey20",
clustering_distance_rows = "correlation",legend = TRUE, legend_breaks = NA,legend_labels = NA,
clustering_distance_cols = "correlation", #"euclidean",#cellwidth = 15, #cellheight = 2,
fontsize = 12,fontsize_row = 12, fontsize_col = 12, display_numbers = F,
number_format = "%.0f", number_color = "grey60", fontsize_number = 2)
dev.off()
Infos <-  final_data[which(final_data$geneName %in% maker),]
write.table(Infos,file = "./figs_T21/Pvalues_markers.txt",sep="\t",quote = F,row.names = F)
###################################################################
#################
TF <- read.table("../lib/TF.txt",header=F)
Methy <- read.table("../lib/methylation.txt",header=F)
################# OE vs WT (OPP+)
plotTable <- final_data
plotTable_up <- plotTable[which( plotTable$FoldC_R1_WT  >=  1.5  & plotTable$FDR_R1_WT <  0.05 ) ,]
plotTable_down <- plotTable[which( plotTable$FoldC_R1_WT  <=  -1.5  & plotTable$FDR_R1_WT <  0.05 ) ,]
plotTable_other <- plotTable[which(!(plotTable$geneName %in% plotTable_up$geneName | plotTable$geneName %in% plotTable_down$geneName)) ,]
plotTable_TF <- plotTable[(plotTable$geneName %in% TF$V1),]
plotTable_sig1 <- plotTable_up[(plotTable_up$geneName %in% plotTable_TF$geneName),]
plotTable_sig2 <- plotTable_down[(plotTable_down$geneName %in% plotTable_TF$geneName),]
plotTable_methy <- plotTable[(plotTable$geneName %in% Methy$V1),]
plotTable_EBF <- plotTable[(plotTable$geneName %in% c("MGMT","MKI67","ZNF22","PRRX1","EYA1","EBF1","EBF2","EBF3","MGMT","TET2","DNMT1","UHRF1")),]
mySub2 <- ggplot()+theme_classic()
mySub2 <- mySub2 + geom_point(data = plotTable_other, aes(x =  (FoldC_R1_WT), y = -log10(FDR_R1_WT)),fill="grey",alpha=0.5,size=1.8, shape = 21,stroke=0.2)
mySub2 <- mySub2 + geom_point(data = plotTable_up,    aes(x =  (FoldC_R1_WT), y = -log10(FDR_R1_WT)),fill=gg_color_hue(3)[1]   ,alpha=0.6,size=1.8, shape = 21,stroke=0.2)
mySub2 <- mySub2 + geom_point(data = plotTable_down,    aes(x =  (FoldC_R1_WT), y = -log10(FDR_R1_WT)),fill=gg_color_hue(3)[3] ,alpha=0.6,size=1.8, shape = 21,stroke=0.2)
mySub2 <- mySub2 + geom_point(data = plotTable_sig1,    aes(x =   (FoldC_R1_WT), y = -log10(FDR_R1_WT)),fill=gg_color_hue(3)[1],alpha=0.6,size=1.8, shape = 21,stroke=0.5,color="black")
mySub2 <- mySub2 + geom_point(data = plotTable_sig2,    aes(x =   (FoldC_R1_WT), y = -log10(FDR_R1_WT)),fill=gg_color_hue(3)[3],alpha=0.6,size=1.8, shape = 21,stroke=0.5,color="black")
mySub2 <- mySub2 + geom_vline(xintercept = 1.5,linetype=2,color="grey50") +
geom_vline(xintercept = -1.5,linetype=2,color="grey50") +
geom_hline(yintercept = -log10(0.05),linetype=2,color="grey50")
mySub2 <- mySub2 + geom_text_repel(data =plotTable_up, aes(x = (FoldC_R1_WT), y = -log10(FDR_R1_WT),label=geneName),
segment.color = "black", segment.size =0.2,size =2,color ='black', seed = 42, box.padding = 0.5)
mySub2 <- mySub2 + geom_text_repel(data =plotTable_down, aes(x = (FoldC_R1_WT), y = -log10(FDR_R1_WT),label=geneName),
segment.color = "black", segment.size =0.2,size =2,color ='black', seed = 42, box.padding = 0.5)
#mySub2 <- mySub2 + geom_text_repel(data =plotTable_sig2, aes(x = (FoldC_R1_WT), y = -log10(FDR_R1_WT),label=geneName),
#                                   size =2,color ='black')
mySub2 <- mySub2 + geom_text_repel(data =plotTable_EBF, aes(x = (FoldC_R1_WT), y = -log10(FDR_R1_WT),label=geneName),
segment.color = "black", segment.size =0.2,size =2,color ='black', seed = 42, box.padding = 0.5)
#mySub2 <- mySub2 +geom_text(data =plotTable_up,   aes(x = (FoldC_R1_WT), y = -log10(FDR_R1_WT),label = geneName), size =0.3,color ='black')
#mySub2 <- mySub2 +geom_text(data =plotTable_down,   aes(x = (FoldC_R1_WT), y = -log10(FDR_R1_WT),label = geneName), size =0.3,color ='black')
mySub2 <- mySub2 + xlab("Fold change log2( TMZ / untreated)") + ylab("-log10(adjusted p-value)") +
scale_y_continuous(expand=c(0,0),limits=c(-0.2,12),breaks=seq(-6,20,2)) +
scale_x_continuous(expand=c(0,0),limits=c(-6.6,6.1),breaks=seq(-6,6,1))
mySub2 <- mySub2 + theme(panel.background=element_rect(fill='transparent',color='transparent'),plot.margin=unit(c(2,1,0.5,1),'lines'),plot.title=element_text(size=14,vjust=0.5,hjust=0.5,face='bold.italic'),
legend.key.width=unit(1.5,'cm'),legend.key.height=unit(0.5,'cm'),legend.position='top',
legend.margin=margin(t=0.1,r=0.1,b=0,l=0.1,unit='cm'),legend.text=element_text(size=12),axis.text.y=element_text(size=10,face='plain',color='black'),
axis.text.x=element_text(size=10,face='plain',color='black'),axis.title.x=element_text(size=12,face='plain',color='black'),axis.title.y=element_text(size=12,hjust=0.5,vjust=2,face='plain',color='black'))
figure_4<-rbind(ggplotGrob(mySub2),size="last")
ggsave(file="./figs_T21/volcano_TMZ_vs_WT_methy.pdf", plot=figure_4,bg = 'white', width = 12, height = 9, units = 'cm', dpi = 600)
